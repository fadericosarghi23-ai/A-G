---
/**
 * ProjectStack — mazzo di carte progetto trascinabile (home).
 * Il pannello di sinistra viene riempito via JS leggendo i data-* delle carte:
 * non togliere né rinominare gli attributi data-*, l'animazione ci si appoggia.
 */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { testo } from '../lib/testo';

interface Props {
  projects: CollectionEntry<'progetti'>[];
}
const { projects } = Astro.props;
const total = String(projects.length).padStart(2, '0');
---

<section class="pstack">
  <div class="container pstack__grid">
    <div class="pstack__info">
      <p class="eyebrow" data-reveal>Progetti <span class="eyebrow--muted">selezionati</span></p>

      <div class="pstack__panel" data-panel>
        <!-- Questi nodi sono riempiti dallo script del mazzo: lasciarli vuoti. -->
        <p class="pstack__cat" data-f-cat></p>
        <h2 class="pstack__title" data-f-title></h2>
        <p class="pstack__excerpt" data-f-excerpt></p>
        <dl class="pstack__meta">
          <div>
            <dt>Ambito</dt>
            <dd data-f-kind></dd>
          </div>
          <div class="pstack__meta-loc">
            <dt>Luogo</dt>
            <dd data-f-loc></dd>
          </div>
          <div>
            <dt>Anno</dt>
            <dd data-f-year></dd>
          </div>
        </dl>
        <a class="tlink pstack__link" data-f-link href="/progetti/">Scopri il progetto &#8599;</a>
      </div>

      <div class="pstack__foot">
        <div class="pstack__counter"><span data-counter>01</span> <i>/</i> <span>{total}</span></div>
        <div class="pstack__ctrls">
          <button type="button" class="pstack__btn" data-prev aria-label="Progetto precedente">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M15 18l-6-6 6-6"></path></svg>
          </button>
          <button type="button" class="pstack__btn" data-next aria-label="Progetto successivo">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 18l6-6-6-6"></path></svg>
          </button>
        </div>
        <a class="tlink pstack__all" href="/progetti/">Tutti i progetti &#8599;</a>
      </div>
    </div>

    <div class="pstack__stage" data-reveal>
      <div class="pstack__deck" data-deck>
        {projects.map((p, i) => (
          <article
            class="pcard"
            data-i={i}
            data-cat={p.data.categoryLabel}
            data-title={p.data.title}
            data-excerpt={testo(p.data.excerpt)}
            data-kind={p.data.credits}
            data-loc={p.data.location || '—'}
            data-year={p.data.year}
            data-href={`/progetti/${p.id}/`}
          >
            <Image
              src={p.data.cover}
              alt={p.data.title}
              widths={[500, 800, 1100]}
              sizes="(min-width:900px) 32vw, 80vw"
              loading="eager"
              draggable={false}
              class="pcard__img"
            />
            <span class="pcard__tag" data-c-cat></span>
          </article>
        ))}
      </div>
      <p class="pstack__hint" data-hint>Trascina o clicca la foto per scorrere</p>
    </div>
  </div>
</section>

<script>
  // Mazzo di carte: drag, click, frecce e tastiera. Codice invariato rispetto al sito di partenza.
