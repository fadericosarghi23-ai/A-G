<style>
.pstack {
  min-height:100svh;
  display:flex;
  align-items:center;
  padding-block:clamp(3rem,6vh,4.5rem);
  background:var(--bg)
}

.pstack__grid {
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:clamp(2rem,6vw,6rem);
  align-items:center;
  width:100%
}

.pstack__info {
  display:flex;
  flex-direction:column
}

.pstack__panel {
  margin-top:1.6rem
}

.pstack__cat {
  font-size:.74rem;
  font-weight:600;
  letter-spacing:.16em;
  text-transform:uppercase;
  color:var(--accent);
  margin:0 0 1rem;
  min-height:1em
}

.pstack__title {
  font-size:clamp(2rem,4.2vw,3.4rem);
  letter-spacing:-.025em;
  line-height:1.02
}

.pstack__excerpt {
  font-size:1.02rem;
  line-height:1.6;
  color:var(--muted);
  margin:1.1rem 0 1.6rem;
  max-width:34rem;
  display:-webkit-box;
  -webkit-line-clamp:3;
  -webkit-box-orient:vertical;
  overflow:hidden
}

.pstack__meta {
  display:flex;
  gap:2rem;
  margin:0 0 1.6rem;
  flex-wrap:wrap
}

.pstack__meta dt {
  font-size:.68rem;
  font-weight:600;
  letter-spacing:.12em;
  text-transform:uppercase;
  color:var(--muted);
  margin-bottom:.25rem
}

.pstack__meta dd {
  margin:0;
  font-size:.98rem;
  font-weight:500
}

.pstack__link {
  display:inline-block;
  font-size:.95rem
}

.pstack__panel {
  transition:opacity .35s var(--ease),transform .35s var(--ease)
}

.pstack__panel.is-swapping {
  opacity:0;
  transform:translateY(8px)
}

.pstack__foot {
  display:flex;
  align-items:center;
  gap:1.4rem;
  margin-top:2.4rem;
  padding-top:1.4rem;
  border-top:1px solid var(--line)
}

.pstack__counter {
  font-family:var(--font-display);
  font-size:1rem;
  font-weight:500;
  letter-spacing:.02em
}

.pstack__counter span:first-child {
  font-size:1.5rem;
  color:var(--accent)
}

.pstack__counter i {
  color:var(--line-strong);
  font-style:normal;
  margin:0 .2rem
}

.pstack__ctrls {
  display:flex;
  gap:.5rem
}

.pstack__btn {
  width:44px;
  height:44px;
  display:grid;
  place-items:center;
  background:transparent;
  border:1px solid var(--line-strong);
  color:var(--ink);
  transition:all .3s var(--ease)
}

.pstack__btn:hover {
  border-color:var(--ink);
  background:var(--ink);
  color:var(--on-dark)
}

.pstack__all {
  margin-left:auto;
  font-size:.9rem
}

.pstack__stage {
  position:relative;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center
}

.pstack__deck {
  position:relative;
  width:clamp(260px,30vw,400px);
  aspect-ratio:4 / 5;
  perspective:1200px;
  touch-action:pan-y
}

.pcard {
  position:absolute;
  left:50%;
  top:50%;
  width:100%;
  height:100%;
  transform:translate(-50%,-50%);
  transform-origin:center;
  will-change:transform,opacity;
  overflow:hidden;
  background:var(--surface);
  box-shadow:0 30px 60px -25px #11111173,0 8px 20px -12px #1111114d;
  user-select:none;
  -webkit-user-select:none
}

.pcard.is-top {
  cursor:grab
}

.pcard.is-dragging {
  cursor:grabbing
}

.pcard__img {
  width:100%;
  height:100%;
  object-fit:cover;
  pointer-events:none
}

.pcard__tag {
  position:absolute;
  left:1rem;
  bottom:1rem;
  z-index:2;
  background:#111111d1;
  color:var(--on-dark);
  backdrop-filter:blur(4px);
  font-size:.66rem;
  font-weight:600;
  letter-spacing:.12em;
  text-transform:uppercase;
  padding:.4rem .7rem;
  opacity:0;
  transition:opacity .3s var(--ease)
}

.pcard.is-top .pcard__tag {
  opacity:1
}

.pstack__hint {
  margin-top:2.2rem;
  font-size:.82rem;
  color:var(--muted);
  letter-spacing:.02em
}

@media(max-width:900px) {
  .pstack {
    min-height:0;
    padding-block:clamp(3.5rem,8vw,5rem)
  }
  .pstack__grid {
    grid-template-columns:1fr;
    gap:2.5rem
  }
  .pstack__stage {
    order:-1
  }
  .pstack__deck {
    width:min(78vw,320px)
  }
  .pstack__foot {
    flex-wrap:wrap
  }
}
</style>
