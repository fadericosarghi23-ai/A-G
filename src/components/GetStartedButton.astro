---
/**
 * GetStartedButton — bottone principale con riempimento animato e freccia
 * che ruota seguendo il mouse (data-getstarted). Non modificare lo script.
 */
interface Props {
  href?: string;
  size?: 'sm' | 'md' | 'lg';
  label?: string;
  ariaLabel?: string;
  type?: 'button' | 'submit';
  class?: string;
}

const {
  href,
  size = 'md',
  label = "Contattaci",
  ariaLabel,
  type,
  class: className = '',
} = Astro.props;

const classes = ['gsbtn', `gsbtn--${size}`, className].filter(Boolean).join(' ');
const Tag = href ? 'a' : 'button';
---

<Tag
  data-getstarted="true"
  aria-label={ariaLabel ?? label}
  href={href}
  type={href ? undefined : (type ?? 'button')}
  class={classes}
>
  <span class="gsbtn__fill" aria-hidden="true"></span>
  <span class="gsbtn__label">{label}</span>
  <svg class="gsbtn__arrow" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <line x1="5" y1="12" x2="19" y2="12"></line>
    <polyline points="12 5 19 12 12 19"></polyline>
  </svg>
</Tag>

<script>
  // Freccia che punta verso il cursore. Codice invariato rispetto al sito di partenza.
  const c=(e,t)=>{const n=(t-e+540)%360-180;return e+n},l=window.matchMedia("(prefers-reduced-motion: reduce)").matches;document.querySelectorAll("[data-getstarted]").forEach(e=>{if(l)return;let t=-45;const n=e.querySelector(".gsbtn__arrow"),s=r=>{t=r,n&&n.style.setProperty("--gs-angle",`${r}deg`)};e.addEventListener("mousemove",r=>{const o=e.getBoundingClientRect(),a=o.left+o.width/2,d=o.top+o.height/2,i=Math.atan2(r.clientY-d,r.clientX-a)*(180/Math.PI);s(c(t,i))}),e.addEventListener("mouseleave",()=>s(c(t,-45)))});
</script>

<style>
.gsbtn {
  --gs-bg: var(--accent);
  --gs-fg: #ffffff;
  --gs-fill: var(--bg);
  --gs-hover-fg: var(--accent);
  position:relative;
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:.5rem;
  height:3.5rem;
  padding-inline:1.75rem;
  overflow:hidden;
  border-radius:999px;
  border:2px solid transparent;
  background:var(--gs-bg);
  color:var(--gs-fg);
  font-family:var(--font-body);
  font-size:.9rem;
  font-weight:500;
  letter-spacing:.01em;
  white-space:nowrap;
  cursor:pointer;
  text-decoration:none;
  transition:color .3s var(--ease),border-color .3s var(--ease)
}

.gsbtn--sm {
  height:2.75rem;
  padding-inline:1.25rem;
  font-size:.82rem
}

.gsbtn:hover,
.gsbtn:focus-visible {
  color:var(--gs-hover-fg);
  border-color:var(--gs-bg);
  outline:none
}

.gsbtn:focus-visible {
  box-shadow:0 0 0 2px var(--bg),0 0 0 4px var(--gs-bg)
}

.gsbtn__fill {
  pointer-events:none;
  position:absolute;
  left:50%;
  top:50%;
  width:1.25rem;
  height:1.25rem;
  transform:translate(-50%,-50%) scale(0);
  border-radius:999px;
  background:var(--gs-fill);
  transition:transform .5s ease-out
}

.gsbtn:hover .gsbtn__fill,
.gsbtn:focus-visible .gsbtn__fill {
  transform:translate(-50%,-50%) scale(42)
}

.gsbtn__label {
  position:relative;
  z-index:1
}

.gsbtn__arrow {
  position:relative;
  z-index:1;
  transform:rotate(var(--gs-angle, -45deg));
  transition:transform .15s linear
}

.gsbtn--outline {
  --gs-bg: transparent;
  --gs-fill: var(--accent);
  color:var(--on-dark);
  border-color:#f4f2ee80
}

.gsbtn--outline:hover,
.gsbtn--outline:focus-visible {
  color:#fff;
  border-color:var(--accent)
}

@media(prefers-reduced-motion:reduce) {
  .gsbtn__fill {
    transition:none
  }
  .gsbtn__arrow {
    transition:none;
    transform:rotate(-45deg)!important
  }
}
</style>
