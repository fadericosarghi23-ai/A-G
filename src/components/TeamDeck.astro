---
/**
 * TeamDeck — mazzo di ritratti del team (desktop) con pannello che cambia al click,
 * più un elenco di schede come fallback (mobile / reduced-motion).
 * I data-name / data-role / data-bio alimentano il pannello: non rinominarli.
 *
 * Testi: biografie del team, da compilare con il materiale del cliente.
 */
import { Image } from 'astro:assets';
// Ritratti dal sito attuale (490x490, ritagliati 4/5 via CSS).
// [[DA COMPILARE: ritratti in alta risoluzione — quelli del sito attuale sono 490 px]]
import angela from '../assets/studio/angela-culletta.png';
import ghena from '../assets/studio/filgena-haxhari.png';

const TEAM = [
  {
    name: 'Arch. Angela Culletta',
    short: 'Angela',
    role: 'La A di A+G · Sede di Biella',
    foto: angela,
    bio: "Laureata in Architettura a Palermo e iscritta all'Ordine degli Architetti dal 2012 e membro del Consiglio dal 2016. Con esperienza in progettazione d'interni a Milano, cantieristica per lavori pubblici presso imprese edili e collaborazione presso uno studio di architettura per la realizzazione di grandi opere. Nel 2016 incontro Ghena e dal 2019 sono la A di A+G ARCHITETTURA.",
  },
  {
    name: 'Arch. Filgena Haxhari',
    short: 'Ghena',
    role: 'La G di A+G · Sede di Vercelli',
    foto: ghena,
    bio: "Laureata in Architettura a Torino e iscritta all'Ordine degli Architetti dal 2016. Con esperienza nella progettazione esecutiva e direzione lavori nel mondo dell'arredo bagno, nella pubblica amministrazione in ufficio tecnico comunale e collaborazione con uno studio di architettura per la realizzazione di ristrutturazioni e grandi opere. Nel 2016 incontro Angela e dal 2019 sono la G di A+G ARCHITETTURA.",
  },
];
const total = String(TEAM.length).padStart(2, '0');
---

<div class="tdeck" data-teamdeck>
  <div class="tdeck__grid">
    <div class="tdeck__stage" data-deck>
      {TEAM.map((m, i) => (
        <button
          class="tcard"
          type="button"
          data-i={i}
          data-name={m.name}
          data-role={m.role}
          data-bio={m.bio}
          aria-label={m.name}
        >
          <Image
            src={m.foto}
            alt={m.name}
            widths={[320, 640]}
            sizes="320px"
            loading="eager"
            draggable={false}
            class="tcard__img"
          />
          <span class="tcard__name">{m.short}</span>
        </button>
      ))}
    </div>

    <div class="tdeck__info">
      <div class="tdeck__panel" data-panel>
        <!-- Riempiti dallo script del mazzo: lasciarli vuoti. -->
        <h3 class="tdeck__name" data-f-name></h3>
        <p class="tdeck__role" data-f-role></p>
        <p class="tdeck__bio muted" data-f-bio></p>
      </div>
      <div class="tdeck__foot">
        <span class="tdeck__counter"><b data-counter>01</b> / {total}</span>
        <div class="tdeck__ctrls">
          <button type="button" class="tdeck__btn" data-prev aria-label="Membro precedente">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M15 18l-6-6 6-6"></path></svg>
          </button>
          <button type="button" class="tdeck__btn" data-next aria-label="Membro successivo">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 18l6-6-6-6"></path></svg>
          </button>
        </div>
      </div>
    </div>
  </div>

  <div class="tdeck__fallback">
    {TEAM.map((m) => (
      <article class="tmember">
        <Image
          src={m.foto}
          alt={m.name}
          widths={[500, 900]}
          sizes="(min-width:820px) 45vw, 90vw"
          loading="lazy"
          class="tmember__img"
        />
        <h3 class="tmember__name">{m.name}</h3>
        <p class="tmember__role">{m.role}</p>
        <p class="tmember__bio muted">{m.bio}</p>
      </article>
    ))}
  </div>
</div>

<script>
  // Mazzo del team: click sulle carte, frecce e pannello che cambia. Codice invariato.
const m=window.matchMedia("(prefers-reduced-motion: reduce)").matches;document.querySelectorAll("[data-teamdeck]").forEach(s=>{if(m)return;const l=s.querySelector("[data-deck]"),i=Array.from(s.querySelectorAll(".tcard")),n=i.length;if(!l||n===0)return;const d=s.querySelector("[data-panel]"),u=s.querySelector("[data-counter]");let a=0;const y=e=>{const r=e.dataset,t=(c,g)=>{const p=s.querySelector(`[data-f-${c}]`);p&&(p.textContent=g)};t("name",r.name||""),t("role",r.role||""),t("bio",r.bio||"")},S=()=>{u&&(u.textContent=String(a+1).padStart(2,"0")),d?(d.classList.add("is-swapping"),setTimeout(()=>{y(i[a]),d.classList.remove("is-swapping")},190)):y(i[a])},f=()=>{i.forEach((e,r)=>{let t=r-a;t>n/2&&(t-=n),t<-n/2&&(t+=n);const c=Math.abs(t);e.style.transform=`translate(-50%, -50%) translateX(${t*42}px) rotate(${t*7}deg) scale(${1-c*.08})`,e.style.zIndex=String(n-c),e.style.opacity=c>2?"0":String(1-c*.16),e.style.pointerEvents=c>2?"none":"auto",e.classList.toggle("is-active",t===0)}),S()},o=e=>{a=(a+e+n)%n,f()};s.querySelector("[data-next]")?.addEventListener("click",()=>o(1)),s.querySelector("[data-prev]")?.addEventListener("click",()=>o(-1)),i.forEach((e,r)=>e.addEventListener("click",()=>{r!==a&&(a=r,f())})),l.setAttribute("tabindex","0"),l.addEventListener("keydown",e=>{e.key==="ArrowRight"&&(e.preventDefault(),o(1)),e.key==="ArrowLeft"&&(e.preventDefault(),o(-1))}),f()});</script>

<style>
.tdeck__grid {
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:clamp(2rem,6vw,5rem);
  align-items:center
}

.tdeck__stage {
  position:relative;
  height:clamp(360px,44vw,460px)
}

.tcard {
  position:absolute;
  left:50%;
  top:50%;
  width:clamp(220px,26vw,300px);
  aspect-ratio:4 / 5;
  margin:0;
  padding:0;
  border:1px solid var(--line);
  background:var(--surface);
  overflow:hidden;
  transform-origin:center bottom;
  cursor:pointer;
  will-change:transform;
  box-shadow:0 24px 50px -26px #11111180;
  transition:transform .7s cubic-bezier(.16,1,.3,1),opacity .7s cubic-bezier(.16,1,.3,1),box-shadow .5s ease
}

.tcard__img {
  width:100%;
  height:100%;
  object-fit:cover;
  pointer-events:none;
  transition:filter .5s var(--ease)
}

.tcard:not(.is-active) .tcard__img {
  filter:saturate(.85) brightness(.96)
}

.tcard__name {
  position:absolute;
  left:0;
  right:0;
  bottom:0;
  padding:1.4rem .9rem .7rem;
  font-size:.82rem;
  font-weight:600;
  letter-spacing:.02em;
  color:#fff;
  text-align:center;
  background:linear-gradient(transparent,#111111cc);
  opacity:0;
  transition:opacity .4s var(--ease)
}

.tcard.is-active .tcard__name {
  opacity:1
}

.tcard.is-active {
  cursor:default
}

.tdeck__info {
  display:flex;
  flex-direction:column
}

.tdeck__panel {
  min-height:12rem;
  transition:opacity .35s var(--ease),transform .35s var(--ease)
}

.tdeck__panel.is-swapping {
  opacity:0;
  transform:translateY(8px)
}

.tdeck__name {
  font-size:clamp(1.6rem,3vw,2.2rem);
  letter-spacing:-.02em
}

.tdeck__role {
  font-size:.82rem;
  font-weight:600;
  letter-spacing:.04em;
  color:var(--accent);
  text-transform:uppercase;
  margin:.6rem 0 1.1rem
}

.tdeck__bio {
  font-size:.98rem;
  line-height:1.65;
  max-width:34rem
}

.tdeck__foot {
  display:flex;
  align-items:center;
  gap:1.4rem;
  margin-top:2rem;
  padding-top:1.3rem;
  border-top:1px solid var(--line)
}

.tdeck__counter {
  font-family:var(--font-display);
  font-size:1rem;
  color:var(--muted)
}

.tdeck__counter b {
  font-size:1.5rem;
  font-weight:500;
  color:var(--accent)
}

.tdeck__ctrls {
  display:flex;
  gap:.5rem;
  margin-left:auto
}

.tdeck__btn {
  width:44px;
  height:44px;
  display:grid;
  place-items:center;
  background:transparent;
  border:1px solid var(--line-strong);
  color:var(--ink);
  transition:all .3s var(--ease)
}

.tdeck__btn:hover {
  background:var(--ink);
  color:var(--on-dark);
  border-color:var(--ink)
}

.tdeck__fallback {
  display:none;
  grid-template-columns:repeat(2,1fr);
  gap:clamp(2rem,4vw,3.5rem) 3rem
}

.tmember__img {
  width:100%;
  aspect-ratio:4/5;
  object-fit:cover;
  margin-bottom:1.2rem
}

.tmember__name {
  font-size:1.5rem;
  letter-spacing:-.02em
}

.tmember__role {
  font-size:.82rem;
  font-weight:600;
  letter-spacing:.04em;
  color:var(--accent);
  text-transform:uppercase;
  margin:.5rem 0 .9rem
}

.tmember__bio {
  font-size:.95rem;
  line-height:1.6
}

@media(max-width:820px) {
  .tdeck__grid {
    grid-template-columns:1fr;
    gap:2.5rem
  }
  .tdeck__stage {
    order:-1;
    height:clamp(340px,90vw,420px)
  }
  .tdeck__fallback {
    grid-template-columns:1fr
  }
}

@media(prefers-reduced-motion:reduce) {
  .tdeck__grid {
    display:none
  }
  .tdeck__fallback {
    display:grid
  }
}
</style>
