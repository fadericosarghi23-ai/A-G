---
/**
 * Metodo — le tre fasi di lavoro dello studio.
 * Tre fasi, tre card ciascuna (titolo + descrizione breve), da ricavare dai testi del cliente.
 * Dove manca la frase, resta il segnaposto.
 */
import BaseLayout from '../layouts/BaseLayout.astro';

// Card ricavate dalle pagine servizio del sito attuale (Mini call, Chiedi ad A+G, La stanza che vorrei,
// Casa senza pensieri), con nomi e prezzi così come li pubblica lo studio.
// [[DA VALIDARE: titoli delle fasi e sintesi delle card scritti da noi su quei testi]]
const PHASES = [
  {
    n: '01',
    title: 'Conosciamoci',
    cards: [
      { t: 'Mini call gratuita', d: "Una video chiamata di 15 minuti per conoscerci e capire come possiamo esserti d'aiuto per la tua casa. È gratuita!" },
      { t: 'Chiedi ad A+G', d: "Due video chiamate di un'ora per risolvere i dubbi più urgenti su casa, colori e arredi. € 149." },
      { t: 'Sopralluoghi e rilievi', d: 'Appuntamenti, sopralluoghi e rilievi per comprendere al meglio le tue necessità e i tuoi desideri.' },
    ],
  },
  {
    n: '02',
    title: 'Il progetto',
    cards: [
      { t: 'La stanza che vorrei', d: 'Interni e decorazioni per uno o più ambienti attraverso piccoli interventi. A partire da € 350.' },
      { t: 'Casa senza pensieri', d: 'Per chi deve costruire, progettare o ristrutturare casa: progettazione a tutto tondo, con preventivo su misura.' },
      { t: 'Book di progetto', d: 'Planimetrie arredate, moodboard, palette colori e shopping list con i riferimenti per gli acquisti.' },
    ],
  },
  {
    n: '03',
    title: 'Il cantiere',
    cards: [
      { t: 'Pratiche edilizie', d: 'Prepariamo e presentiamo gli elaborati tecnici agli enti competenti, poi ci prepariamo ai lavori.' },
      { t: 'Imprese e fornitori', d: 'Coordiniamo imprese, artigiani e mobilieri e ti affianchiamo nella scelta delle finiture e dei fornitori.' },
      { t: 'Direzione dei lavori', d: 'Direzione dei lavori, sicurezza del cantiere e direzione artistica degli interni, fino alle chiavi.' },
    ],
  },
];
---

<BaseLayout
  title="Come lavoriamo · A+G Architettura"
  description="Dalla mini call gratuita alle chiavi in mano: come A+G Architettura segue progetto, pratiche e cantiere della tua casa a Biella, Vercelli e in Piemonte."
>
  <main id="main">
    <section class="mhead section">
      <div class="container">
        <p class="eyebrow" data-reveal>Metodo</p>
        <h1 class="display mhead__title" data-reveal>Come<br />lavoriamo</h1>
        <p class="lead mhead__lead" data-reveal>
          Ti offriamo una progettazione a tutto tondo, che partirà dalle fasi preliminari di studio del progetto, analizzando tutti i costi da affrontare, le lavorazioni e le maestranze da coinvolgere, fino ad arrivare alla vera e propria realizzazione del progetto. Tutto questo mettendo in primo piano la progettazione degli interni!
        </p>
      </div>
    </section>

    <section class="section msteps section--tint">
      <div class="container">
        {PHASES.map((ph) => (
          <div class="mphase" data-reveal>
            <div class="mphase__head">
              <span class="mphase__n">{ph.n}</span>
              <h2 class="mphase__title">{ph.title}</h2>
            </div>
            <div class="mphase__steps" data-stagger>
              {ph.cards.map((c) => (
                <div class="mcard">
                  <h3 class="mcard__t">{c.t}</h3>
                  <p class="mcard__d muted">{c.d}</p>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
.mhead {
  padding-top:calc(var(--header-h) + clamp(2.5rem,6vw,5rem));
  padding-bottom:0
}

.mhead__title {
  margin:1rem 0 1.6rem
}

.mhead__lead {
  max-width:48rem
}

.mphase {
  padding-block:clamp(2.5rem,5vw,4rem);
  border-top:1px solid var(--line)
}

.mphase:first-child {
  border-top:2px solid var(--ink)
}

.mphase__head {
  display:flex;
  align-items:baseline;
  gap:1.2rem;
  margin-bottom:2rem
}

.mphase__n {
  font-family:var(--font-display);
  font-size:clamp(2.5rem,5vw,4rem);
  font-weight:600;
  color:var(--accent);
  line-height:.8;
  letter-spacing:-.03em
}

.mphase__title {
  font-size:clamp(1.6rem,3vw,2.4rem);
  letter-spacing:-.02em
}

.mphase__steps {
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:1.5rem
}

.mcard {
  position:relative;
  border-top:1px solid var(--line);
  padding-top:1rem
}

.mcard:before {
  content:"";
  position:absolute;
  top:-1px;
  left:0;
  height:2px;
  width:0;
  background:var(--accent);
  transition:width .5s var(--ease)
}

.mcard:hover:before {
  width:100%
}

.mcard__t {
  font-size:1.05rem;
  margin-bottom:.5rem;
  letter-spacing:-.01em;
  transition:color .3s var(--ease)
}

.mcard:hover .mcard__t {
  color:var(--accent)
}

.mcard__d {
  font-size:.9rem;
  line-height:1.55
}

@media(max-width:820px) {
  .mphase__steps {
    grid-template-columns:1fr 1fr
  }
}

@media(max-width:520px) {
  .mphase__steps {
    grid-template-columns:1fr
  }
}
</style>
